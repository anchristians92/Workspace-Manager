<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WorkspaceManager.Addon.Remote</AssemblyName>
    <RootNamespace>WorkspaceManager.Addon.Remote</RootNamespace>
    <Version>1.0.0</Version>
    <Product>WorkspaceManager Addon Fernwartung</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- The app itself provides this assembly at runtime; do not ship a second copy. -->
    <ProjectReference Include="..\..\src\WorkspaceManager\WorkspaceManager.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
